TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
WEBVIEW_BASE_URL=https://your-app.onrender.com/report

# Used only by `npm run migrate` (scripts/migrate.ts) to apply sql/schema.sql
# directly. Get this from Supabase: Project settings > Database > Connection
# string > URI (Session pooler is recommended, works from most networks).
DATABASE_URL=postgresql://postgres.xxxx:your_db_password@aws-0-region.pooler.supabase.com:5432/postgres

# Base URL of the React webview (expense-report-web), no trailing slash
WEBVIEW_BASE_URL=https://your-webview.vercel.app

# Secret used to sign/verify the token embedded in webview links.
# Generate a strong random value, e.g.: openssl rand -hex 32
REPORT_TOKEN_SECRET=change_me_to_a_long_random_string

# Origin allowed to call GET /api/report - set to your webview's exact URL
# in production, "*" is fine for local dev
CORS_ORIGIN=*

# Secret checked against header x-cron-secret on POST /internal/send-weekly-reports.
# Generate with: openssl rand -hex 32
CRON_SECRET=change_me_to_a_different_long_random_string


# Port the API server (Express) listens on
PORT=3000