TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Used only by `npm run migrate` (scripts/migrate.ts) to apply sql/schema.sql
DATABASE_URL=postgresql://postgres.xxxx:your_db_password@aws-0-region.pooler.supabase.com:5432/postgres

# Base URL of the React webview (expense-report-web), no trailing slash
WEBVIEW_BASE_URL=https://your-webview.vercel.app

# Secret used to sign/verify the token embedded in webview links.
# Generate a strong random value, e.g.: openssl rand -hex 32
REPORT_TOKEN_SECRET=change_me_to_a_long_random_string

# Origin allowed to call GET /api/report - set to your webview's exact URL
# in production, "*" is fine for local dev
CORS_ORIGIN=*

# Secret used to authenticate Admin API requests via the X-Admin-Secret header.
# Generate with: openssl rand -hex 32
ADMIN_API_SECRET=change_me_to_admin_secret

# Comma-separated Telegram chat IDs of admin users.
# Admin users can use /pending, /approve, /block, /stats commands in chat.
# Leave empty to disable admin chat commands (REST API still works).
ADMIN_CHAT_IDS=

# Port the API server listens on
PORT=3000

# --- Timezone ---
# IMPORTANT: Set this in your deployment environment (Render/Railway env vars).
# All date logic (cron schedules, "today" checks, date ranges) uses process timezone.
# Without this, the server defaults to UTC and cron fires at wrong local time.
TZ=Asia/Ho_Chi_Minh

# --- AI Parser (Gemini) ---
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Model to use. Options (cheapest → best):
#   gemini-3.5-flash-lite  → $0.30/1M input, $2.50/1M output (recommended, cheapest)
#   gemini-3.6-flash       → $1.50/1M input, $7.50/1M output
GEMINI_MODEL=gemini-3.5-flash-lite

# Model for multimodal parsing (voice/image). Requires vision + audio support.
# Default: gemini-3.5-flash-lite (supports text, image, and audio input)
# Note: gemini-2.0-flash and gemini-2.0-flash-lite were shut down on 2026-06-01.
GEMINI_MULTIMODAL_MODEL=gemini-3.5-flash-lite

# --- Notification Schedule (cron expressions, times are in TZ above = Asia/Ho_Chi_Minh) ---
# Default: 8:00 PM Vietnam time daily
DAILY_REMINDER_CRON=0 20 * * *
# Default: 8:00 PM Vietnam time every Sunday
WEEKLY_DIGEST_CRON=0 20 * * 0
# Default: 8:00 PM Vietnam time last day of month
# Note: The `cron` library doesn't support `L` (last day). We use 28-31
# and guard in code with an isLastDayOfMonth() check.
MONTHLY_SUMMARY_CRON=0 20 28-31 * *
