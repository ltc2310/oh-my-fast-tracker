{
  "version": "v1",
  "hooks": [
    {
      "name": "Run Tests on File Save",
      "trigger": "PostFileSave",
      "description": "Runs the test suite automatically whenever a TypeScript file is saved",
      "matcher": "\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "npx jest --runInBand --passWithNoTests 2>&1 | tail -20",
        "timeout": 120
      },
      "enabled": false
    }
  ]
}